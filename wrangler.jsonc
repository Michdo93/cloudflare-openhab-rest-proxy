{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-openhab-rest-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "vars": {
    "MYOPENHAB_BASE_URL": "https://myopenhab.org",
    "OPENHAB_API_PREFIX": "/rest",
    "ACCESS_MODE": "public-demo",
    "CORS_ALLOWED_ORIGINS": "http://localhost:5173",
    "ALLOWED_ITEMS_JSON": "{\"Demo_Light\":{\"read\":true,\"commands\":[\"ON\",\"OFF\"]},\"Demo_Temperature\":{\"read\":true,\"commands\":[]}}",
    "MAX_COMMAND_LENGTH": "64",
    "UPSTREAM_TIMEOUT_MS": "15000"
  },
  "secrets": {
    "required": ["MYOPENHAB_EMAIL", "MYOPENHAB_PASSWORD"]
  }
}
