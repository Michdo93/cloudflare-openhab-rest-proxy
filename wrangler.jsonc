{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-openhab-rest-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // lets the Worker notice at once when a browser closes the event stream
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "vars": {
    // myopenHAB, or your own openHAB behind HTTPS
    "OPENHAB_URL": "https://myopenhab.org",
    // public-demo: everyone may use the allowlist; access: Cloudflare Access
    "ACCESS_MODE": "access",
    // exact origins of your dashboards, comma-separated
    "CORS_ALLOWED_ORIGINS": "http://localhost:5173",
    // which items may be read and commanded – see README
    "ALLOWED_ITEMS_JSON": "{\"Demo_Licht\":{\"read\":true,\"commands\":\"type\",\"type\":\"Switch\"},\"Demo_Temperatur\":{\"read\":true}}",
    "MAX_COMMAND_LENGTH": "64",
    "UPSTREAM_TIMEOUT_MS": "15000"
  },
  // optional: at most 20 commands per client and minute (needs a free Workers plan)
  "ratelimits": [
    {
      "name": "COMMAND_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
