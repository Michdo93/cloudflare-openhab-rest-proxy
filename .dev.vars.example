# Copy to .dev.vars for "wrangler dev". Never commit .dev.vars.
# For the cloud: secrets via "npx wrangler secret put <NAME>".

# myopenHAB: e-mail and password of the account (HTTP Basic)
OPENHAB_USER=you@example.com
OPENHAB_PASSWORD=change-me

# Optional: API token of openHAB. With OPENHAB_USER it is sent as
# X-OPENHAB-TOKEN (myopenHAB), without it as Bearer token (direct openHAB).
OPENHAB_TOKEN=

# Only for ACCESS_MODE=access
ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
ACCESS_AUD=replace-with-the-application-audience
